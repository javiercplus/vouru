#!/bin/bash
# Installer for VOURU launcher (always fetches latest from GitHub)

set -e

# Default installation directory: user's local bin
DEFAULT_INSTALL_DIR="$HOME/.local/bin"
INSTALL_DIR="${INSTALL_DIR:-$DEFAULT_INSTALL_DIR}"
LAUNCHER_NAME="vouru"
LAUNCHER_PATH="$INSTALL_DIR/$LAUNCHER_NAME"
REPO_URL="https://github.com/javiercplus/vouru/raw/refs/heads/main/vouru"

# Create temp file explicitly in /tmp
TMP_LAUNCHER="$(mktemp -p /tmp vouru-launcher.XXXXXX)"

# Clean up temp file on exit (even if script fails)
cleanup() {
    rm -f "$TMP_LAUNCHER"
}
trap cleanup EXIT

# Function to detect and use privilege escalation (only needed if we ever install system-wide)
run_priv() {
    if [ -w "$INSTALL_DIR" ]; then
        # No privilege needed
        "$@"
    elif command -v doas &>/dev/null; then
        doas "$@"
    elif command -v sudo &>/dev/null; then
        sudo "$@"
    elif command -v su &>/dev/null; then
        local cmd_str
        printf -v cmd_str '%q ' "$@"
        su -c "$cmd_str"
    else
        echo "Error: No privilege escalation tool found (doas, sudo, su)." >&2
        echo "Please install to a writable directory, e.g.:" >&2
        echo "  INSTALL_DIR=~/.local/bin ./install-vouru.sh" >&2
        exit 1
    fi
}

# Ensure installation directory exists (create if needed)
if [ ! -d "$INSTALL_DIR" ]; then
    echo "Creating directory: $INSTALL_DIR"
    mkdir -p "$INSTALL_DIR"
fi

# Check if directory is writable; if not, fallback to privilege escalation
if [ ! -w "$INSTALL_DIR" ]; then
    echo "Directory $INSTALL_DIR is not writable; will use privilege escalation."
fi

# Create the launcher script content
cat > "$TMP_LAUNCHER" <<'EOF'
#!/bin/bash
# VOURU launcher - executes the latest version from GitHub
# This script is auto-generated; do not edit directly.

REPO_URL="https://github.com/javiercplus/vouru/raw/refs/heads/main/vouru"

if command -v curl &>/dev/null; then
    curl -sSL "$REPO_URL" | bash -s "$@"
else
    echo "Error: curl is required to run vouru." >&2
    exit 1
fi
EOF

# Install the launcher
echo "Installing VOURU launcher to $LAUNCHER_PATH ..."
run_priv cp "$TMP_LAUNCHER" "$LAUNCHER_PATH"
run_priv chmod +x "$LAUNCHER_PATH"

echo "VOURU launcher installed at $LAUNCHER_PATH"
echo "You can now run 'vouru <command>' from anywhere."
echo "It will always fetch the latest version from GitHub."

# Check if INSTALL_DIR is in PATH
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    echo "Warning: $INSTALL_DIR is not in your PATH."
    echo "   Add it to your ~/.bashrc or ~/.profile with:"
    echo "   export PATH=\"\$HOME/.local/bin:\$PATH\""
fi

echo ""
echo "Example: vouru search firefox"
