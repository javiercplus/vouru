#!/usr/bin/env bash
# VOURU - Void User Repository helper for xbps-src
#
# The whole body is guarded so that pasting or sourcing this file into an
# interactive shell does NOT execute anything or produce output. It runs when
# invoked as a script (./vouru, bash vouru) or when piped in
# (curl ... | bash -s, where stdin is not a tty).
if [ -n "${BASH_SOURCE[0]}" ] || [ ! -t 0 ]; then
set -euo pipefail

DEFAULT_VURU_DIR="$HOME/.local/share/pkgs/void-packages"
CONFIG_FILE="$HOME/.voururc"
SOURCE_INDEX_FILE="$HOME/.config/vouru/template-sources.tsv"
IS_CONFIGURED=false

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
        if [ -n "${VURU_DIR:-}" ]; then
            IS_CONFIGURED=true
        else
            VURU_DIR="$DEFAULT_VURU_DIR"
        fi
    else
        VURU_DIR="$DEFAULT_VURU_DIR"
    fi
    export VURU_DIR
}

save_config() {
    echo "VURU_DIR=\"$VURU_DIR\"" > "$CONFIG_FILE"
}

load_config

VURU_LOG="$HOME/.vouru.log"
V_MAIN="\e[1;32m" # Green
V_PKG="\e[1;34m"  # Blue
V_ERR="\e[1;31m"  # Red
V_RST="\e[0m"     # Default

echo "=== VOURU Log started at $(date) ===" >> "$VURU_LOG"

VURU_REQUIRED=("git" "xtools")
for check in "${VURU_REQUIRED[@]}"; do
    if ! xbps-query -S "$check" &>/dev/null; then
        echo -e "${V_ERR}Error: '$check' is not installed.${V_RST}" >&2
        exit 1
    fi
done

PRIV_CMD=""
if command -v doas &>/dev/null; then
    PRIV_CMD="doas"
elif command -v sudo &>/dev/null; then
    PRIV_CMD="sudo"
else
    echo -e "${V_ERR}Error: Neither 'doas' nor 'sudo' found.${V_RST}" >&2
    exit 1
fi

run_priv() {
    "$PRIV_CMD" "$@"
}

configure_xbps_src() {
    local conf_file="$VURU_DIR/etc/conf"
    local su_cmd="${PRIV_CMD} /bin/sh -c"
    mkdir -p "$(dirname "$conf_file")"
    if grep -q "^XBPS_SUCMD=" "$conf_file" 2>/dev/null; then
        sed -i "s|^XBPS_SUCMD=.*|XBPS_SUCMD=\"${su_cmd}\"|" "$conf_file"
    else
        echo "XBPS_SUCMD=\"${su_cmd}\"" >> "$conf_file"
    fi
}

spinner() {
    local pid=$1
    local msg=$2
    local spin='-\|/'
    local i=0
    while kill -0 $pid 2>/dev/null; do
        i=$(( (i+1) % 4 ))
        printf "\r[%c] %s" "${spin:$i:1}" "$msg"
        sleep 0.15
    done
    local exit_code=0
    wait $pid || exit_code=$?
    if [ $exit_code -eq 0 ]; then
        printf "\r[✓] %s\n" "$msg"
    else
        printf "\r[✗] %s\n" "$msg"
    fi
    return $exit_code
}

run_with_spinner() {
    local msg="$1"
    shift
    echo "--- Running: $* ---" >> "$VURU_LOG"
    ( "$@" >> "$VURU_LOG" 2>&1 ) &
    local pid=$!
    local ret=0
    spinner $pid "$msg" || ret=$?
    if [ $ret -ne 0 ]; then
        echo -e "${V_ERR}Command failed. Check $VURU_LOG for details.${V_RST}" >&2
    fi
    return $ret
}

apply_templates_from_url() {
    local repo_url="$1"
    local target_dir="$2"
    local branch="${3:-}"
    local tmp_dir
    tmp_dir="$(mktemp -d)"

    local clone_args=("--depth" "1")
    if [ -n "$branch" ]; then
        clone_args+=("-b" "$branch")
    fi

    if ! git clone "${clone_args[@]}" "$repo_url" "$tmp_dir" >> "$VURU_LOG" 2>&1; then
        rm -rf "$tmp_dir"
        return 1
    fi

    while IFS= read -r template_file; do
        local template_dir pkg_name
        template_dir="$(dirname "$template_file")"
        if [ "$template_dir" = "$tmp_dir" ]; then
            pkg_name="$(grep -m1 '^pkgname=' "$template_file" | cut -d= -f2- | tr -d "\"'")"
        else
            pkg_name="$(basename "$template_dir")"
        fi
        if [ -z "$pkg_name" ]; then continue; fi
        rm -rf "$target_dir/srcpkgs/$pkg_name/.git" 2>/dev/null || true
        mkdir -p "$target_dir/srcpkgs/$pkg_name"
        cp -rf "$template_dir"/. "$target_dir/srcpkgs/$pkg_name/"
    done < <(find -L "$tmp_dir" -type f -name "template" -not -path "*/.git/*" | sort -u)

    rm -rf "$tmp_dir"
    return 0
}

ensure_repo() {
    if [ ! -d "$VURU_DIR" ]; then
        if [ "$IS_CONFIGURED" = true ]; then
            echo -e "${V_ERR}Error: Configured void-packages repository at '$VURU_DIR' not found.${V_RST}" >&2
            echo -e "${V_ERR}Please verify the path or use '$(basename "$0") set-repo' to change it.${V_RST}" >&2
            exit 1
        else
            echo -e "${V_MAIN}Repository not found. Initial cloning to default location ($VURU_DIR)...${V_RST}"
            run_with_spinner "Cloning void-packages repository (shallow)" git clone --depth 1 https://github.com/void-linux/void-packages.git "$VURU_DIR"
            cd "$VURU_DIR" || exit 1
            run_with_spinner "Running binary-bootstrap" ./xbps-src binary-bootstrap
            cd - >/dev/null
        fi
    else
        cd "$VURU_DIR" || exit 1
        configure_xbps_src
        cd - >/dev/null
    fi
}

sync_repo() {
    echo -e "${V_MAIN}Synchronizing repository (clean shallow clone overwrite)...${V_RST}"
    local main_repo_url="https://github.com/void-linux/void-packages.git"
    local tmp_refresh tmp_backup
    tmp_refresh="$(mktemp -d)"
    tmp_backup="$(mktemp -d)"

    [ -d "$VURU_DIR/etc" ] && cp -a "$VURU_DIR/etc" "$tmp_backup/"
    [ -d "$VURU_DIR/hostdir" ] && cp -a "$VURU_DIR/hostdir" "$tmp_backup/"

    run_with_spinner "Cloning fresh void-packages to temporary directory" git clone --depth 1 "$main_repo_url" "$tmp_refresh"

    find "$VURU_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
    cp -a "$tmp_refresh"/. "$VURU_DIR/"

    [ -d "$tmp_backup/etc" ] && cp -a "$tmp_backup/etc/." "$VURU_DIR/etc/"
    [ -d "$tmp_backup/hostdir" ] && cp -a "$tmp_backup/hostdir/." "$VURU_DIR/hostdir/"
    rm -rf "$tmp_refresh" "$tmp_backup"

    if [ -f "$SOURCE_INDEX_FILE" ]; then
        echo -e "${V_MAIN}Re-applying externally added templates...${V_RST}"
        local urls
        urls=$(awk -F '\t' -v dir="$VURU_DIR" '$1 == dir {print $3 "\t" $4}' "$SOURCE_INDEX_FILE" | sort -u)
        local reapply_success=true

        while IFS=$'\t' read -r url branch; do
            [ -z "$url" ] && continue
            if ! apply_templates_from_url "$url" "$VURU_DIR" "$branch"; then
                echo -e "${V_ERR}Warning: Failed to re-clone and apply $url.${V_RST}" >&2
                reapply_success=false
            fi
        done <<< "$urls"

        if [ "$reapply_success" = true ]; then
            echo -e "${V_MAIN}External templates re-applied successfully.${V_RST}"
        fi
    fi
    configure_xbps_src
    echo -e "${V_MAIN}Synchronization complete.${V_RST}"
}

show_help() {
    cat <<EOF
Usage: vouru <command> [arguments]

Commands:
  sync                    Clean refresh of main repo + re-apply all added external repos
  update                  Run 'sync', then update xbps-src and the system
  add [-b <branch>] <url> Clone a git repository (shallow) and copy templates into srcpkgs
  search | -s <term>      Search for packages in srcpkgs matching <term>
  source                  List repositories added with 'vouru add' and count templates
  install | -i [--restricted|-R] [--dont-answer-me] <pkg>  Search, compile, and install a package
  remove | -r <pkg>       Remove an installed package (xbps-remove)
  clean | -c              Remove the void-packages repository and purge cached packages
  set-repo [path]         Set the location of the void-packages repository (if no path, prompt)
  -h | --help             Show this help message

Examples:
  vouru sync
  vouru add https://github.com/user/void-packages
  vouru add -b dev https://github.com/user/void-packages
  vouru search firefox
  vouru install --restricted discord
  vouru update
EOF
}

record_template_source() {
    local pkg_name="$1"
    local source_url="$2"
    local branch="${3:-}"
    local index_dir index_tmp

    index_dir="$(dirname "$SOURCE_INDEX_FILE")"
    mkdir -p "$index_dir"
    index_tmp="$(mktemp)"

    if [ -f "$SOURCE_INDEX_FILE" ]; then
        awk -F '\t' -v repo="$VURU_DIR" -v pkg="$pkg_name" \
            '$1 != repo || $2 != pkg' "$SOURCE_INDEX_FILE" > "$index_tmp"
    fi
    printf '%s\t%s\t%s\t%s\n' "$VURU_DIR" "$pkg_name" "$source_url" "$branch" >> "$index_tmp"
    mv "$index_tmp" "$SOURCE_INDEX_FILE"
}

list_template_sources() {
    local total_templates official_templates imported_templates
    local official_url
    local indexed_repo indexed_pkg indexed_url indexed_branch
    local source
    local source_order=()
    declare -A source_counts=()
    declare -A source_branches=()

    ensure_repo
    total_templates="$(find "$VURU_DIR/srcpkgs" -mindepth 2 -maxdepth 2 -type f -name template -printf '.' | wc -c | tr -d ' ')"
    imported_templates=0

    if [ -f "$SOURCE_INDEX_FILE" ]; then
        while IFS=$'\t' read -r indexed_repo indexed_pkg indexed_url indexed_branch; do
            [ "$indexed_repo" = "$VURU_DIR" ] || continue
            [ -f "$VURU_DIR/srcpkgs/$indexed_pkg/template" ] || continue
            if [ -z "${source_counts[$indexed_url]+present}" ]; then
                source_order+=("$indexed_url")
                source_counts["$indexed_url"]=0
                source_branches["$indexed_url"]="$indexed_branch"
            fi
            source_counts["$indexed_url"]=$((source_counts["$indexed_url"] + 1))
            imported_templates=$((imported_templates + 1))
        done < "$SOURCE_INDEX_FILE"
    fi

    official_templates=$((total_templates - imported_templates))
    official_url="$(git -C "$VURU_DIR" remote get-url origin 2>/dev/null || true)"

    echo -e "${V_MAIN}Template sources:${V_RST}"
    echo -e "  ${V_PKG}${official_url:-$VURU_DIR}${V_RST} — ${official_templates} template(s) from the base repository"
    for source in "${source_order[@]}"; do
        local branch_info=""
        if [ -n "${source_branches[$source]}" ]; then
            branch_info=" (branch: ${source_branches[$source]})"
        fi
        echo -e "  ${V_PKG}${source}${V_RST}${branch_info} — ${source_counts[$source]} imported template(s)"
    done
    echo -e "${V_MAIN}\nTotal locally available: ${V_PKG}${total_templates}${V_RST} template(s)"
}

review_template() {
    local template_file="$1"
    local pkg_name="$2"
    if [ ! -f "$template_file" ]; then
        echo -e "${V_ERR}Error: Template file for $pkg_name not found.${V_RST}"
        exit 1
    fi
    echo -e "${V_MAIN}Press any key to open the template for ${V_PKG}$pkg_name${V_MAIN} (press ${V_PKG}'q'${V_MAIN} to close the view when done):${V_RST}"
    read -s -n 1 < /dev/tty
    echo "------------------------------------------------------------"
    if command -v less &>/dev/null; then
        less -R "$template_file"
    else
        cat "$template_file"
        echo -e "${V_ERR}Note: 'less' is not installed. It is recommended for better viewing.${V_RST}"
    fi
    echo "------------------------------------------------------------"
    read -p "Do you want to continue with the compilation and installation of $pkg_name? (y/N): " confirm < /dev/tty
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${V_ERR}Operation cancelled by user.${V_RST}"
        exit 0
    fi
}

is_pkg_installed() {
    xbps-query "$1" &>/dev/null
}

is_pkg_in_official() {
    xbps-query -R "$1" &>/dev/null
}

search_packages() {
    local query="$1"
    ensure_repo
    cd "$VURU_DIR" || exit 1
    mapfile -t MATCHES < <(find srcpkgs -maxdepth 1 -type d -name "*${query}*" -printf "%f\n" | sort -u)
    if [ ${#MATCHES[@]} -eq 0 ]; then
        echo -e "${V_ERR}No packages found matching '$query'.${V_RST}"
        return 1
    fi
    echo -e "${V_MAIN}Matches for '$query':${V_RST}"
    local i=1
    for pkg in "${MATCHES[@]}"; do
        desc=$(grep -m 1 "^short_desc=" "srcpkgs/$pkg/template" 2>/dev/null | cut -d= -f2- | tr -d "\"'")
        echo -e "  ${V_MAIN}$i.${V_RST} ${V_PKG}$pkg${V_RST} - ${desc:-No description}"
        ((i++))
    done
}

install_package() {
    local query="$1"
    local is_restricted="${2:-false}"
    local dont_answer_me="${3:-false}"
    ensure_repo
    cd "$VURU_DIR" || exit 1
    if [ "$dont_answer_me" = "true" ]; then
        mapfile -t MATCHES < <(find srcpkgs -maxdepth 1 -type d -name "$query" -printf "%f\n" | sort -u)
    else
        mapfile -t MATCHES < <(find srcpkgs -maxdepth 1 -type d -name "*${query}*" -printf "%f\n" | sort -u)
    fi
    if [ ${#MATCHES[@]} -eq 0 ]; then
        echo -e "${V_ERR}Error: No package found for '$query'.${V_RST}"
        exit 1
    fi
    local PKG_NAME
    if [ ${#MATCHES[@]} -eq 1 ]; then
        PKG_NAME="${MATCHES[0]}"
        echo -e "${V_MAIN}Package found:${V_RST} ${V_PKG}$PKG_NAME${V_RST}"
    elif [ "$dont_answer_me" = "true" ]; then
        echo -e "${V_ERR}Error: Package '$query' not found (exact match required with --dont-answer-me).${V_RST}"
        exit 1
    else
        echo -e "${V_MAIN}Multiple matches found:${V_RST}"
        local i=1
        for pkg in "${MATCHES[@]}"; do
            desc=$(grep -m 1 "^short_desc=" "srcpkgs/$pkg/template" 2>/dev/null | cut -d= -f2- | tr -d "\"'")
            echo -e "  ${V_MAIN}$i.${V_RST} ${V_PKG}$pkg${V_RST} - ${desc:-No description}"
            ((i++))
        done
        echo ""
        read -p "Select a number to install: " choice < /dev/tty
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt ${#MATCHES[@]} ]; then
            echo -e "${V_ERR}Invalid selection. Aborting.${V_RST}"
            exit 1
        fi
        PKG_NAME="${MATCHES[$((choice-1))]}"
    fi
    if is_pkg_installed "$PKG_NAME"; then
        echo -e "${V_MAIN}Package ${V_PKG}$PKG_NAME${V_MAIN} is already installed.${V_RST}"
        if [ "$dont_answer_me" = "true" ]; then
            echo -e "${V_MAIN}Reinstalling (forced by --dont-answer-me)...${V_RST}"
        else
            read -p "Do you want to reinstall/rebuild it? (y/N): " reinstall_choice < /dev/tty
            if [[ ! "$reinstall_choice" =~ ^[Yy]$ ]]; then
                echo -e "${V_ERR}Installation skipped.${V_RST}"
                exit 0
            fi
        fi
    fi
    local has_template=false
    local has_official=false
    if [ -d "srcpkgs/$PKG_NAME" ] && [ -f "srcpkgs/$PKG_NAME/template" ]; then
        has_template=true
    fi
    if is_pkg_in_official "$PKG_NAME"; then
        has_official=true
    fi
    if [ "$dont_answer_me" = "true" ]; then
        if ! $has_template; then
            echo -e "${V_ERR}Error: No source template found for $PKG_NAME in srcpkgs.${V_RST}" >&2
            echo -e "${V_ERR}Use 'vouru add <git-url>' to add a template.${V_RST}" >&2
            exit 1
        fi
        echo -e "${V_MAIN}Compiling from source (--dont-answer-me, skipping all prompts)...${V_RST}"
    elif $has_official && $has_template; then
        echo ""
        echo -e "${V_MAIN}Package ${V_PKG}$PKG_NAME${V_MAIN} is available from both sources:${V_RST}"
        echo -e "  ${V_MAIN}1.${V_RST} ${V_PKG}[repo]${V_RST}  Install pre-built binary via xbps-install (fast)"
        echo -e "  ${V_MAIN}2.${V_RST} ${V_PKG}[source]${V_RST} Compile from source with xbps-src (latest, customizable)"
        echo ""
        read -p "Choose installation method (1 or 2): " method_choice < /dev/tty
        case "$method_choice" in
            1)
                echo -e "${V_MAIN}Installing from official repositories...${V_RST}"
                run_priv xbps-install -y "$PKG_NAME"
                echo -e "${V_MAIN}Installation from official repos completed.${V_RST}"
                exit 0
                ;;
            2)
                echo -e "${V_MAIN}Compiling from source...${V_RST}"
                ;;
            *)
                echo -e "${V_ERR}Invalid choice. Aborting.${V_RST}"
                exit 1
                ;;
        esac
    elif $has_official; then
        echo -e "${V_MAIN}Package ${V_PKG}$PKG_NAME${V_MAIN} ${V_PKG}[repo]${V_MAIN} is available in the official Void repositories.${V_RST}"
        echo -e "${V_MAIN}(No source template found in srcpkgs.)${V_RST}"
        read -p "Install from official repos? (y/N): " official_choice < /dev/tty
        if [[ "$official_choice" =~ ^[Yy]$ ]]; then
            echo -e "${V_MAIN}Installing from official repositories...${V_RST}"
            run_priv xbps-install -y "$PKG_NAME"
            echo -e "${V_MAIN}Installation from official repos completed.${V_RST}"
            exit 0
        fi
        echo -e "${V_ERR}Installation skipped.${V_RST}"
        exit 0
    elif ! $has_template; then
        echo -e "${V_ERR}Error: No source template found for $PKG_NAME in srcpkgs.${V_RST}" >&2
        echo -e "${V_ERR}Use 'vouru add <git-url>' to add a template, or install from repos if available.${V_RST}" >&2
        exit 1
    fi
    if [ "$dont_answer_me" = "true" ]; then
        echo -e "${V_MAIN}Skipping template review (--dont-answer-me).${V_RST}"
    else
        review_template "srcpkgs/$PKG_NAME/template" "$PKG_NAME"
    fi
    echo -e "\n${V_MAIN}::${V_RST} Compiling ${V_PKG}$PKG_NAME${V_RST}..."
    local restricted_added=false
    if [ "$is_restricted" = "true" ]; then
        if ! grep -q '^XBPS_ALLOW_RESTRICTED=yes' "$VURU_DIR/etc/conf" 2>/dev/null; then
            echo "XBPS_ALLOW_RESTRICTED=yes" >> "$VURU_DIR/etc/conf"
            restricted_added=true
            echo -e "${V_MAIN}:: Temporarily allowing restricted license in etc/conf${V_RST}"
        else
            echo -e "${V_MAIN}:: Restricted license already allowed in etc/conf${V_RST}"
        fi
    fi
    local compile_ret=0
    ./xbps-src pkg "$PKG_NAME" || compile_ret=$?
    if [ "$restricted_added" = "true" ]; then
        sed -i '/^XBPS_ALLOW_RESTRICTED=yes/d' "$VURU_DIR/etc/conf"
        echo -e "${V_MAIN}:: Reverted restricted license allowance in etc/conf${V_RST}"
    fi
    if [ $compile_ret -ne 0 ]; then
        echo -e "\n${V_ERR}Error: Compilation of $PKG_NAME failed.${V_RST}"
        echo -e "${V_ERR}Hint: If this is due to a restricted license, run:${V_RST}"
        echo -e "  ${V_MAIN}vouru install --restricted $PKG_NAME${V_RST}"
        echo -e "${V_ERR}Check $VURU_LOG for full details.${V_RST}"
        exit 1
    fi
    echo -e "\n${V_MAIN}:: Compilation successful. Installing...${V_RST}"
    if [ "$is_restricted" = "true" ]; then
        run_priv xbps-install -y --repository "$VURU_DIR/hostdir/binpkgs" --repository "$VURU_DIR/hostdir/binpkgs/nonfree" "$PKG_NAME"
    else
        run_priv xbps-install -y --repository "$VURU_DIR/hostdir/binpkgs" "$PKG_NAME"
    fi
    echo -e "\n${V_MAIN}:: $PKG_NAME installed successfully.${V_RST}"
}

remove_package() {
    local pkg_name="$1"
    if ! is_pkg_installed "$pkg_name"; then
        echo -e "${V_ERR}Error: Package $pkg_name is not installed.${V_RST}" >&2
        exit 1
    fi
    echo -e "${V_MAIN}About to remove ${V_PKG}$pkg_name${V_RST}"
    read -p "Do you want to continue with the removal of $pkg_name? (y/N): " confirm < /dev/tty
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${V_ERR}Operation cancelled by user.${V_RST}"
        exit 0
    fi
    run_priv xbps-remove -y -o "$pkg_name"
    echo -e "${V_MAIN}\n:: $pkg_name removed successfully (including orphaned packages).${V_RST}"
}

update_all() {
    sync_repo
    cd "$VURU_DIR" || exit 1
    run_with_spinner "Running bootstrap-update" ./xbps-src bootstrap-update
    run_with_spinner "Updating packages with xbps-src (update-sys)" ./xbps-src update-sys
    echo -e "${V_MAIN}xbps-src updated.${V_RST}"
    echo -e "${V_MAIN}\nUpdating system with xbps-install...${V_RST}"
    run_priv xbps-install -Su
    cd - >/dev/null
    echo -e "${V_MAIN}Update complete.${V_RST}"
}

clean_repo() {
    if [ ! -d "$VURU_DIR" ]; then
        echo -e "${V_MAIN}No repository found at $VURU_DIR. Nothing to clean.${V_RST}"
        return
    fi
    echo -e "${V_ERR}This will remove $VURU_DIR (including all compiled packages and source).${V_RST}"
    read -p "Are you sure? (y/N): " confirm < /dev/tty
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -rf "$VURU_DIR"
        echo -e "${V_MAIN}Repository removed successfully.${V_RST}"
        echo -e "${V_MAIN}Cleaning cached packages with xbps-remove -O...${V_RST}"
        run_priv xbps-remove -O
        echo -e "${V_MAIN}Package cache cleaned.${V_RST}"
    else
        echo -e "${V_MAIN}Clean cancelled.${V_RST}"
    fi
}

set_repo_location() {
    local new_path="$1"
    if [ -z "$new_path" ]; then
        read -p "Enter new path for void-packages repository: " new_path < /dev/tty
        if [ -z "$new_path" ]; then
            echo -e "${V_ERR}No path provided. Aborting.${V_RST}"
            return 1
        fi
    fi
    new_path="${new_path/#\~/$HOME}"
    VURU_DIR="$new_path"
    save_config
    IS_CONFIGURED=true
    echo -e "${V_MAIN}Repository location set to: $VURU_DIR${V_RST}"
}

add_template() {
    local repo_url="$1"
    local branch="$2"
    ensure_repo
    cd "$VURU_DIR" || exit 1
    local tmp_dir
    tmp_dir="$(mktemp -d)"

    local clone_args=("--depth" "1")
    if [ -n "$branch" ]; then
        clone_args+=("-b" "$branch")
        echo -e "${V_MAIN}Cloning template repository (shallow, branch: $branch)...${V_RST}"
    else
        echo -e "${V_MAIN}Cloning template repository (shallow)...${V_RST}"
    fi

    if ! git clone "${clone_args[@]}" "$repo_url" "$tmp_dir" >> "$VURU_LOG" 2>&1; then
        echo -e "${V_ERR}Error: Failed to clone repository '$repo_url'.${V_RST}" >&2
        rm -rf "$tmp_dir"
        exit 1
    fi

    local source_url
    source_url="$(git -C "$tmp_dir" remote get-url origin 2>/dev/null || printf '%s' "$repo_url")"

    echo -e "${V_MAIN}Searching for templates...${V_RST}"
    local TEMPLATE_FILES=()
    while IFS= read -r template_file; do
        TEMPLATE_FILES+=("$template_file")
    done < <(find -L "$tmp_dir" -type f -name "template" -not -path "*/.git/*" | sort -u)

    if [ ${#TEMPLATE_FILES[@]} -eq 0 ]; then
        echo -e "${V_ERR}Error: No 'template' file found in the repository.${V_RST}" >&2
        rm -rf "$tmp_dir"
        exit 1
    fi
    echo -e "${V_MAIN}Found ${#TEMPLATE_FILES[@]} template(s) in repository.${V_RST}"

    local added=0
    local top_level=()
    local nested=()
    local root_files=()

    for template_file in "${TEMPLATE_FILES[@]}"; do
        local template_dir
        template_dir="$(dirname "$template_file")"
        if [ "$template_dir" = "$tmp_dir" ]; then
            root_files+=("$template_file")
        else
            local rel
            rel="${template_dir#"$tmp_dir"/}"
            if [[ "$rel" == */* ]]; then
                nested+=("$template_file")
            else
                top_level+=("$template_file")
            fi
        fi
    done

    if [ ${#top_level[@]} -gt 0 ]; then
        local to_copy=()
        for template_file in "${top_level[@]}"; do
            local template_dir pkg_name
            template_dir="$(dirname "$template_file")"
            pkg_name="$(basename "$template_dir")"
            to_copy+=("$template_dir")
        done
        if [ ${#to_copy[@]} -gt 0 ]; then
            cp -rf "${to_copy[@]}" "srcpkgs/"
            for template_dir in "${to_copy[@]}"; do
                local pkg_name
                pkg_name="$(basename "$template_dir")"
                echo -e "${V_MAIN}Added package ${V_PKG}$pkg_name${V_MAIN} from $repo_url${V_RST}"
                record_template_source "$pkg_name" "$source_url" "$branch"
                added=$((added+1))
            done
        fi
    fi

    for template_file in "${root_files[@]}" "${nested[@]}"; do
        local template_dir pkg_name
        template_dir="$(dirname "$template_file")"
        if [[ "$template_dir" == */.git* ]] || [[ "$template_dir" == *.git ]]; then
            continue
        fi
        if [ "$template_dir" = "$tmp_dir" ]; then
            local raw_name
            raw_name="$(grep -m1 '^pkgname=' "$template_file" | cut -d= -f2-)"
            raw_name="${raw_name//\"/}"
            pkg_name="${raw_name//\'/}"
            if [ -z "$pkg_name" ]; then
                echo -e "${V_ERR}Error: Template at root has no 'pkgname=' field. Cannot determine package name.${V_RST}" >&2
                continue
            fi
        else
            pkg_name="$(basename "$template_dir")"
        fi
        rm -rf "$template_dir/.git" 2>/dev/null || true
        mkdir -p "srcpkgs/$pkg_name"
        cp -rf "$template_dir"/. "srcpkgs/$pkg_name/"
        echo -e "${V_MAIN}Added package ${V_PKG}$pkg_name${V_MAIN} from $repo_url${V_RST}"
        record_template_source "$pkg_name" "$source_url" "$branch"
        added=$((added+1))
    done

    rm -rf "$tmp_dir"
    if [ "$added" -eq 0 ]; then
        echo -e "${V_ERR}No packages were added (no templates found).${V_RST}" >&2
        exit 1
    fi
    echo -e "${V_MAIN}Added ${V_PKG}$added${V_MAIN} package(s) (existing ones were overwritten).${V_RST}"
}

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    sync)
        sync_repo
        ;;
    update)
        update_all
        ;;
    search|-s)
        if [ -z "${2:-}" ]; then
            echo -e "${V_ERR}Error: Missing search term.${V_RST}"
            show_help
            exit 1
        fi
        search_packages "$2"
        ;;
    source)
        list_template_sources
        ;;
    install|-i)
        shift
        RESTRICTED_FLAG="false"
        DONT_ANSWER_FLAG="false"
        PKG_NAME_ARG=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --restricted|-R)
                    RESTRICTED_FLAG="true"
                    shift
                    ;;
                --dont-answer-me)
                    DONT_ANSWER_FLAG="true"
                    shift
                    ;;
                *)
                    PKG_NAME_ARG="$1"
                    shift
                    ;;
            esac
        done
        if [ -z "$PKG_NAME_ARG" ]; then
            echo -e "${V_ERR}Error: Missing package name.${V_RST}"
            show_help
            exit 1
        fi
        install_package "$PKG_NAME_ARG" "$RESTRICTED_FLAG" "$DONT_ANSWER_FLAG"
        ;;
    remove|-r)
        if [ -z "${2:-}" ]; then
            echo -e "${V_ERR}Error: Missing package name.${V_RST}"
            show_help
            exit 1
        fi
        remove_package "$2"
        ;;
    clean|-c)
        clean_repo
        ;;
    set-repo)
        set_repo_location "${2:-}"
        ;;
    add)
        shift
        BRANCH_ARG=""
        ADD_URL=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -b|--branch)
                    BRANCH_ARG="$2"
                    shift 2
                    ;;
                *)
                    ADD_URL="$1"
                    shift
                    ;;
            esac
        done
        if [ -z "$ADD_URL" ]; then
            echo -e "${V_ERR}Error: Missing git repository URL.${V_RST}"
            show_help
            exit 1
        fi
        add_template "$ADD_URL" "$BRANCH_ARG"
        ;;
    *)
        install_package "$1" "false"
        ;;
esac
fi
